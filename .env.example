# Copy to .env (same folder) and fill in. .env is git-ignored. Restrict its ACL to the account
# that runs the scheduled task (see RDP_SETUP.md).

# --- Dedicated test account (create one in the app; NOT a real customer, NOT an admin) ---
# Phone users are stored with the phone number as username, so use whichever you log in with.
HC_TEST_USERNAME=
HC_TEST_PASSWORD=

# --- Optional: deeper sign-in checks. Leave empty to skip them. ---
# X-Web-Session-Key for /api/web-session/*  (same value as the server's web-session key config)
HC_WEB_SESSION_KEY=
# X-Office-Key for /api/office/sso/redeem
HC_OFFICE_KEY=

# --- Alert channel: email (same Gmail SMTP account the API sends from) ---
HC_SMTP_HOST=smtp.gmail.com
HC_SMTP_PORT=587
HC_SMTP_USERNAME=info@th.com.ge
HC_SMTP_PASSWORD=
HC_SMTP_FROM=info@th.com.ge
HC_SMTP_FROM_NAME=Suliko HealthCheck

# --- Alert channel: SMS (same smsoffice.ge account/key as Security:SMS_API_KEY) ---
HC_SMS_API_KEY=
# Comma-separated, e.g. 5XXXXXXXX,5YYYYYYYY
HC_SMS_NUMBERS=

# --- Optional dead-man's switch (healthchecks.io or similar) ---
# Pinged after every run that finishes; add /fail to the URL's failure ping automatically.
# If the scheduled task itself dies, THIS service emails/SMS you because pings stop.
HC_HEARTBEAT_URL=
